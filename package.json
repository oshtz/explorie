{
  "name": "explorie",
  "version": "0.2.7",
  "private": true,
  "description": "Ridiculously fast, fully-hackable file manager.",
  "repository": "https://github.com/oshtz/explorie",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm run desktop:dev",
    "dev:watch": "pnpm run desktop:dev:watch",
    "desktop:dev": "cargo run -p explorie-gpui",
    "desktop:dev:watch": "cargo watch -w apps/desktop/gpui -w crates -x \"run -p explorie-gpui\"",
    "desktop:build": "cargo build -p explorie-gpui --release --locked",
    "desktop:smoke:release:windows": "pwsh -NoProfile -File scripts/smoke-gpui-release.ps1",
    "prepare:native": "node scripts/prepare-rclone.mjs && node scripts/prepare-winfsp.mjs",
    "rust:watch": "cargo watch -w apps/desktop/gpui -w apps/cli -w crates -x \"check -p explorie-gpui -p explorie-cli -p explorie-core -p explorie-native-services -p explorie-ffmpeg-wrapper\" -x \"test -p explorie-gpui -p explorie-cli -p explorie-core -p explorie-native-services -p explorie-ffmpeg-wrapper\"",
    "rust:check": "cargo check --workspace",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "release:check": "node scripts/release-check.mjs",
    "release:check:test": "node --test scripts/release-check.test.mjs",
    "test": "cargo test --workspace --no-fail-fast",
    "test:rust": "cargo test --workspace --no-fail-fast",
    "format": "cargo fmt --all",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "**/*.rs": [
      "cargo fmt --"
    ]
  }
}
